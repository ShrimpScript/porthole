<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The tailnet is reached through the Tailscale app's VPN, so plain INTERNET is
         all Porthole needs. No location, no storage, no contacts. -->
    <!-- Android 11+ hides other packages by default; declare the one we detect so
         getPackageInfo(com.tailscale.ipn) works instead of always throwing not-found. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps the session socket alive while backgrounded. There is no backend, so
         there is no push - this is the mechanism, and it is visible to the user. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Installing a downloaded APK: a Porthole release from GitHub, or a build of a project
         published on the computer. Android asks before each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: a working session becomes a status-bar chip with a timer. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".PortholeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Porthole"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Porthole">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Porthole.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- porthole://pair?host=…&code=… from the QR that `portholed pair` prints:
                 the phone's camera opens the app already paired. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="porthole" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- specialUse, not dataSync: dataSync is capped at six hours a day on Android 15,
             and this service is the connection itself, kept for as long as the person
             wants to be reachable. -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the WebSocket to the user's own computer over their Tailscale network open, so tool-approval prompts and turn-finished events reach the phone while the app is in the background." />
        </service>

        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.SessionsWidgetReceiver"
            android:exported="true"
            android:label="Sessions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sessions_widget_info" />
        </receiver>

        <service
            android:name=".widget.PortholeTile"
            android:exported="true"
            android:icon="@drawable/ic_launcher_monochrome"
            android:label="Porthole"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Passive on purpose: the system then calls onStartListening every time the
                 shade opens, so the tile re-reads the snapshot even after the app's process
                 died. An active tile is only refreshed by requestListeningState, which a
                 dead process never sends, and it kept saying "1 working" for good. -->
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
