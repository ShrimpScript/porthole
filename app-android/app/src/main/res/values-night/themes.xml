<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The splash in the dark: the Porthole ground and the light wordmark. Chosen by the
         app's night mode (see values/themes.xml), which follows the selected theme. -->
    <style name="Theme.Porthole.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07100F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/ic_splash_brand</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Porthole</item>
    </style>
</resources>
