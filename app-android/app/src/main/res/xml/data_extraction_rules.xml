<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Porthole stores should leave the phone: the pairing key is bound to this
  device's tailnet identity, so a copy on another phone is useless to its owner and a
  liability in a backup. allowBackup="false" covers Android 11 and below; this file is
  the Android 12+ equivalent.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
